---
import pinnedSlugs from '../../public/pins/manifest.json';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

// /blog/some-post/ -> some-post
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
const hasPin = (pinnedSlugs as string[]).includes(slug);

const postURL = new URL(Astro.url.pathname, Astro.site).href;
const pinImageURL = new URL(`/pins/${slug}.jpg`, Astro.site).href;

// Pinterest strips markup from descriptions but keeps bare URLs, so the link
// rides along in the text as well as in the pin's own destination.
const pinDescription = `${title}. ${description} ${postURL}`;

const pinHref =
	'https://www.pinterest.com/pin/create/button/' +
	`?url=${encodeURIComponent(postURL)}` +
	`&media=${encodeURIComponent(pinImageURL)}` +
	`&description=${encodeURIComponent(pinDescription)}`;
---

{
	hasPin && (
		<a class="pin-button" href={pinHref} target="_blank" rel="noopener noreferrer">
			<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
				<path
					fill="currentColor"
					d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.223.083.345-.09.375-.293 1.194-.333 1.361-.052.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.042-1.002 2.347-1.492 3.143C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"
				/>
			</svg>
			Save to Pinterest
		</a>
	)
}

<style>
	.pin-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		margin: 3em 0 0;
		padding: 0.6em 1.1em;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		color: rgb(var(--black));
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.pin-button:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.pin-button svg {
		flex: none;
	}
	@media print {
		.pin-button {
			display: none;
		}
	}
</style>
