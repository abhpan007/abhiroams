---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/**
	 * Optional imported image. While this is undefined the component renders a
	 * captioned placeholder. To drop in the real photo later: import it at the
	 * top of the post and pass it here — `src={myPhoto}` — that's the only edit.
	 */
	src?: ImageMetadata;
	alt?: string;
	caption: string;
	wide?: boolean;
	width?: number;
	height?: number;
}

const { src, alt, caption, wide = false, width = 1020, height = 620 } = Astro.props;
---

<figure class:list={['figure', { wide }]}>
	{
		src ? (
			<Image src={src} alt={alt ?? caption} width={width} height={height} />
		) : (
			<div class="placeholder" role="img" aria-label={`Image placeholder — ${caption}`}>
				<span class="placeholder-tag">Photo coming soon</span>
			</div>
		)
	}
	<figcaption>{caption}</figcaption>
</figure>

<style>
	.figure {
		margin: 2.5em 0;
	}
	.figure :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 9;
		width: 100%;
		border: 2px dashed rgb(var(--gray-light));
		border-radius: 12px;
		background:
			repeating-linear-gradient(
				45deg,
				rgba(var(--gray-light), 0.35),
				rgba(var(--gray-light), 0.35) 12px,
				transparent 12px,
				transparent 24px
			);
	}
	.placeholder-tag {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		background: #fff;
		padding: 0.4em 0.9em;
		border-radius: 999px;
		box-shadow: 0 1px 4px rgba(var(--gray), 25%);
	}
	figcaption {
		margin-top: 0.75em;
		font-size: 0.85rem;
		line-height: 1.5;
		color: rgb(var(--gray));
		text-align: center;
	}
</style>
