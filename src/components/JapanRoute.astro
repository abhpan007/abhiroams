---
// A small, static route graphic for the Japan trip. No interactivity — it just
// gives the reader a sense of scale: where we went and in what order.
const stops = [
	{ n: 1, name: 'Tokyo', x: 60, y: 150, place: 'below' },
	{ n: 2, name: 'Hokkaido', x: 170, y: 110, place: 'above' },
	{ n: 3, name: 'Hiroshima', x: 285, y: 150, place: 'below' },
	{ n: 4, name: 'Onomichi', x: 400, y: 110, place: 'above' },
	{ n: 5, name: 'Kyoto', x: 515, y: 150, place: 'below' },
	{ n: 6, name: 'Osaka', x: 625, y: 110, place: 'above' },
	{ n: 7, name: 'Okinawa', x: 710, y: 150, place: 'below' },
];
const linePoints = stops.map((s) => `${s.x},${s.y}`).join(' ');
---

<figure class="route">
	<svg viewBox="0 0 760 210" role="img" aria-label="Trip route: Tokyo, Hokkaido, Hiroshima, Onomichi, Kyoto, Osaka, Okinawa">
		<polyline points={linePoints} class="route-line" />
		{
			stops.map((s) => (
				<g>
					<circle cx={s.x} cy={s.y} r="6" class="route-dot" />
					<text
						x={s.x}
						y={s.place === 'above' ? s.y - 16 : s.y + 28}
						class="route-label"
						text-anchor="middle"
					>
						{s.n} · {s.name}
					</text>
				</g>
			))
		}
	</svg>
	<figcaption>
		Tokyo to Okinawa — seven regions in a little under three weeks. One set of flights
		booked, almost nothing in between.
	</figcaption>
</figure>

<style>
	.route {
		margin: 2.5em 0;
	}
	.route svg {
		width: 100%;
		height: auto;
	}
	.route-line {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-dasharray: 5 6;
		stroke-linecap: round;
		opacity: 0.7;
	}
	.route-dot {
		fill: var(--accent);
		stroke: #fff;
		stroke-width: 2;
	}
	.route-label {
		font-family: var(--font-atkinson, sans-serif);
		font-size: 13px;
		font-weight: 700;
		fill: rgb(var(--gray-dark));
	}
	figcaption {
		margin-top: 0.5em;
		font-size: 0.85rem;
		line-height: 1.5;
		color: rgb(var(--gray));
		text-align: center;
	}
</style>
