<style>
	footer {
		padding: 2.5em 2em;
		background: #fff;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.copyright {
		margin: 0;
		font-size: 0.875em;
		color: rgb(var(--gray));
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 1.25em;
	}
	.social-links a {
		color: rgb(var(--gray));
		text-decoration: none;
		display: flex;
		align-items: center;
		transition: color 0.15s ease;
	}
	.social-links a:hover {
		color: rgb(var(--black));
	}
	@media (max-width: 600px) {
		.footer-inner {
			flex-direction: column;
			gap: 1.25em;
			text-align: center;
		}
	}
</style>
