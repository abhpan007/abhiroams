---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
	src?: ImageMetadata;
	alt?: string;
	caption?: string;
}

interface Props {
	/**
	 * 2 or 3 images shown side by side. Each item renders a captioned
	 * placeholder until you give it a `src` (import the image and pass it),
	 * so the collage can be wired in one item at a time.
	 */
	items: Item[];
	caption?: string;
	wide?: boolean;
}

const { items, caption, wide = false } = Astro.props;
const count = Math.min(items.length, 3);
---

<figure class:list={['collage', { wide }]}>
	<div class:list={['grid', `grid-${count}`]}>
		{
			items.map((it) =>
				it.src ? (
					<Image src={it.src} alt={it.alt ?? it.caption ?? ''} width={1100} />
				) : (
					<div class="placeholder" role="img" aria-label={`Image placeholder: ${it.caption ?? 'photo'}`}>
						<span class="placeholder-tag">{it.caption ?? 'Photo'}</span>
					</div>
				),
			)
		}
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.collage {
		margin: 2.5em 0;
	}
	.grid {
		display: grid;
		gap: 0.75rem;
		align-items: start;
	}
	.grid-2 {
		grid-template-columns: 1fr 1fr;
	}
	.grid-3 {
		grid-template-columns: 1fr 1fr 1fr;
	}
	.grid :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		box-shadow: var(--box-shadow);
	}
	.placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		aspect-ratio: 4 / 3;
		width: 100%;
		padding: 0.5em;
		border: 2px dashed rgb(var(--gray-light));
		border-radius: 10px;
		background: repeating-linear-gradient(
			45deg,
			rgba(var(--gray-light), 0.35),
			rgba(var(--gray-light), 0.35) 10px,
			transparent 10px,
			transparent 20px
		);
	}
	.placeholder-tag {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: rgb(var(--gray));
		background: #fff;
		padding: 0.35em 0.7em;
		border-radius: 999px;
		box-shadow: 0 1px 4px rgba(var(--gray), 25%);
	}
	figcaption {
		margin-top: 0.75em;
		font-size: 0.85rem;
		line-height: 1.5;
		color: rgb(var(--gray));
		text-align: center;
	}
	@media (max-width: 600px) {
		.grid-2,
		.grid-3 {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
