---
interface Props {
	cite?: string;
}

const { cite } = Astro.props;
---

<blockquote class="pullquote">
	<div class="pullquote-body">
		<slot />
	</div>
	{cite && <cite class="pullquote-cite">{cite}</cite>}
</blockquote>

<style>
	.pullquote {
		margin: 3em 0;
		padding: 0;
		border: none;
		text-align: left;
	}
	.pullquote-body :global(p) {
		font-size: 1.45rem;
		line-height: 1.5;
		font-weight: 400;
		letter-spacing: -0.01em;
		color: rgb(var(--black));
		margin: 0 0 0.6em;
		border-left: 4px solid var(--accent);
		padding-left: 0.9em;
	}
	.pullquote-cite {
		display: block;
		margin-top: 0.5em;
		padding-left: 1.05em;
		font-style: normal;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.pullquote-body :global(p) {
			font-size: 1.2rem;
		}
	}
</style>
