---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((p) => p.data.category === 'cant-roam')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Can't Roam — ${SITE_TITLE}`}
			description="Austin and Dallas local finds — restaurants, spots, and things worth doing when I'm home."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header fade-in">
				<h1>Abhi Can't Roam</h1>
				<p class="page-intro">
					Not every week involves a flight. When I'm home in Austin or Dallas, I'm still
					eating well, exploring neighborhoods, and finding the places worth knowing about.
					This is that list.
				</p>
			</div>

			{posts.length > 0 ? (
				<div class="post-grid">
					{posts.map((post, i) => (
						<article class={`card fade-in ${i === 0 ? 'card-featured' : ''}`}>
							<a href={`/blog/${post.id}/`} class="card-link">
								{post.data.heroImage ? (
									<div class="card-image">
										<Image
											width={i === 0 ? 1200 : 720}
											height={i === 0 ? 600 : 480}
											src={post.data.heroImage}
											alt={post.data.title}
										/>
									</div>
								) : (
									<div class="card-image card-image-placeholder">
										<span>{post.data.title.charAt(0)}</span>
									</div>
								)}
								<div class="card-body">
									<p class="card-date"><FormattedDate date={post.data.pubDate} /></p>
									<h2 class="card-title">{post.data.title}</h2>
									{post.data.description && (
										<p class="card-desc">{post.data.description}</p>
									)}
									<span class="card-read">Read &rarr;</span>
								</div>
							</a>
						</article>
					))}
				</div>
			) : (
				<div class="empty fade-in">
					<p>Posts coming soon. Check back after my next Austin dinner.</p>
					<a href="/blog">In the meantime, read the travel posts &rarr;</a>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.08 },
	);
	document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>

<style>
	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 2em 6em;
	}
	.fade-in {
		opacity: 0;
		transform: translateY(32px);
		transition: opacity 0.65s ease, transform 0.65s ease;
	}
	.fade-in.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Page header */
	.page-header {
		padding: 4em 0 3em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 3.5em;
		max-width: 640px;
	}
	.page-header h1 {
		font-size: 3rem;
		letter-spacing: -0.04em;
		margin: 0 0 0.75em;
		line-height: 1;
	}
	.page-intro {
		font-size: 1.05rem;
		color: rgb(var(--gray));
		line-height: 1.7;
		margin: 0;
	}

	/* Cards */
	.post-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}
	.card-featured {
		grid-column: 1 / -1;
	}
	.card-link {
		display: block;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.card-image {
		width: 100%;
		overflow: hidden;
		border-radius: 6px;
		margin-bottom: 1.25rem;
		background: rgb(var(--gray-light));
		aspect-ratio: 16 / 7;
	}
	.card-featured .card-image {
		aspect-ratio: 16 / 7;
	}
	.post-grid .card:not(.card-featured) .card-image {
		aspect-ratio: 3 / 2;
	}
	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}
	.card-link:hover .card-image img {
		transform: scale(1.04);
	}
	.card-image-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.card-image-placeholder span {
		font-size: 6rem;
		font-weight: 700;
		color: rgb(var(--gray));
		opacity: 0.2;
	}
	.card-date {
		font-size: 0.78rem;
		color: rgb(var(--gray));
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin: 0 0 0.5em;
	}
	.card-title {
		font-size: 1.4rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
		margin: 0 0 0.6em;
		transition: color 0.15s ease;
	}
	.card-featured .card-title {
		font-size: 2rem;
	}
	.card-link:hover .card-title {
		color: var(--accent);
	}
	.card-desc {
		font-size: 0.95rem;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0 0 1em;
	}
	.card-read {
		font-size: 0.85rem;
		font-weight: 600;
		color: rgb(var(--black));
		border-bottom: 2px solid var(--accent);
		padding-bottom: 1px;
		transition: color 0.15s ease;
	}
	.card-link:hover .card-read {
		color: var(--accent);
	}

	/* Empty state */
	.empty {
		padding: 3em 0 4em;
	}
	.empty p {
		font-size: 1.1rem;
		color: rgb(var(--gray));
		margin-bottom: 1em;
	}
	.empty a {
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 2px;
	}

	@media (max-width: 768px) {
		main {
			padding: 0 1.25em 4em;
		}
		.page-header {
			padding: 2.5em 0 2em;
			margin-bottom: 2.5em;
		}
		.page-header h1 {
			font-size: 2.25rem;
		}
		.post-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.card-featured {
			grid-column: 1;
		}
	}
</style>
