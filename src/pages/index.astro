---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Every image in src/assets/hero/ becomes a slide automatically.
// To add or remove a slide, just add or remove a file in that folder.
const heroModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/hero/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp}',
	{ eager: true },
);
const heroImages = await Promise.all(
	Object.values(heroModules).map((mod) =>
		getImage({ src: mod.default, width: 1920, format: 'webp' }),
	),
);

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- Full-bleed hero slideshow -->
		<section class="hero-full">
			<div class="slides">
				{heroImages.map((img, i) => (
					<div
						class={`slide ${i === 0 ? 'active' : ''}`}
						style={`background-image: url('${img.src}')`}
					></div>
				))}
			</div>
			<div class="hero-overlay"></div>
			<div class="hero-content">
				<h1 class="tagline">I roam.<br />You should too.</h1>
				<p class="intro">
					30+ countries down. Every one of them on the list. Come along for the ride.
				</p>
				<a href="/blog" class="hero-cta">Read the blog &rarr;</a>
			</div>
			<div class="dots">
				{heroImages.map((_, i) => (
					<button class={`dot ${i === 0 ? 'active' : ''}`} data-dot={i} aria-label={`Slide ${i + 1}`}></button>
				))}
			</div>
		</section>

		<!-- Recent posts -->
		<main>
			<section class="recent-posts">
				<h2 class="section-heading">Recent</h2>
				<ul class="post-list">
					{
						posts.map((post, index) => (
							<li class={index === 0 ? 'post-item featured fade-in' : 'post-item fade-in'}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage ? (
										<div class="post-image">
											<Image
												width={index === 0 ? 1100 : 600}
												height={index === 0 ? 520 : 400}
												src={post.data.heroImage}
												alt={post.data.title}
											/>
										</div>
									) : (
										<div class="post-image post-image-placeholder">
											<span>{post.data.title.charAt(0)}</span>
										</div>
									)}
									<div class="post-meta">
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="post-title">{post.data.title}</h3>
										{post.data.description && (
											<p class="post-description">{post.data.description}</p>
										)}
										<span class="post-read">Read &rarr;</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
				<div class="all-posts-link fade-in">
					<a href="/blog">All posts &rarr;</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	// Slideshow
	const slides = document.querySelectorAll('.slide');
	const dots = document.querySelectorAll('.dot');
	let current = 0;
	let timer: ReturnType<typeof setInterval>;

	function goTo(index: number) {
		slides[current].classList.remove('active');
		dots[current].classList.remove('active');
		current = index;
		slides[current].classList.add('active');
		dots[current].classList.add('active');
	}

	function startTimer() {
		timer = setInterval(() => goTo((current + 1) % slides.length), 4500);
	}

	dots.forEach((dot, i) => {
		dot.addEventListener('click', () => {
			clearInterval(timer);
			goTo(i);
			startTimer();
		});
	});

	startTimer();

	// Scroll fade-in
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.08 },
	);
	document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>

<style>
	/* ── Hero slideshow ─────────────────────────── */
	.hero-full {
		position: relative;
		width: 100%;
		height: 92vh;
		min-height: 520px;
		overflow: hidden;
	}
	.slides {
		position: absolute;
		inset: 0;
	}
	.slide {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0;
		transition: opacity 1.4s ease;
	}
	.slide.active {
		opacity: 1;
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0.15) 0%,
			rgba(0, 0, 0, 0.4) 55%,
			rgba(0, 0, 0, 0.65) 100%
		);
		z-index: 1;
	}
	.hero-content {
		position: absolute;
		bottom: 14%;
		left: 0;
		right: 0;
		padding: 0 4em;
		z-index: 2;
		max-width: 1100px;
		margin: 0 auto;
	}
	.tagline {
		font-size: clamp(2.25rem, 7vw, 5.5rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: #fff;
		margin: 0 0 1rem;
	}
	.intro {
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.85);
		max-width: 500px;
		line-height: 1.7;
		margin: 0 0 2rem;
	}
	.hero-cta {
		display: inline-block;
		font-size: 0.95rem;
		font-weight: 600;
		color: #fff;
		text-decoration: none;
		border-bottom: 2px solid rgba(255, 255, 255, 0.6);
		padding-bottom: 2px;
		transition: border-color 0.15s ease;
	}
	.hero-cta:hover {
		border-bottom-color: #fff;
	}
	.dots {
		position: absolute;
		bottom: 5%;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 8px;
		z-index: 2;
	}
	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.35);
		border: none;
		cursor: pointer;
		padding: 0;
		transition: background 0.3s ease, transform 0.3s ease;
	}
	.dot.active {
		background: #fff;
		transform: scale(1.35);
	}

	/* ── Recent posts ───────────────────────────── */
	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 2em;
	}
	.fade-in {
		opacity: 0;
		transform: translateY(32px);
		transition: opacity 0.65s ease, transform 0.65s ease;
	}
	.fade-in.visible {
		opacity: 1;
		transform: translateY(0);
	}
	.recent-posts {
		padding: 4em 0 5em;
	}
	.section-heading {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin: 0 0 2rem;
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2rem;
	}
	.post-item.featured {
		grid-column: 1 / -1;
	}
	.post-item a {
		display: block;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.post-item a:hover .post-title {
		color: var(--accent);
	}
	.post-image {
		margin-bottom: 1rem;
		overflow: hidden;
		border-radius: 6px;
		background: rgb(var(--gray-light));
	}
	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 6px;
		transition: transform 0.5s ease;
	}
	.post-item a:hover .post-image img {
		transform: scale(1.04);
	}
	.post-item.featured .post-image {
		aspect-ratio: 16 / 7;
	}
	.post-item:not(.featured) .post-image {
		aspect-ratio: 3 / 2;
	}
	.post-image-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.post-image-placeholder span {
		font-size: 4rem;
		font-weight: 700;
		color: rgb(var(--gray));
		opacity: 0.25;
	}
	.post-date {
		margin: 0 0 0.375rem;
		font-size: 0.8rem;
		color: rgb(var(--gray));
		letter-spacing: 0.04em;
	}
	.post-title {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
		line-height: 1.25;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}
	.post-item.featured .post-title {
		font-size: 1.75rem;
	}
	.post-description {
		margin: 0 0 0.75em;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		line-height: 1.5;
	}
	.post-read {
		font-size: 0.85rem;
		font-weight: 600;
		color: rgb(var(--black));
		border-bottom: 2px solid var(--accent);
		padding-bottom: 1px;
		transition: color 0.15s ease;
	}
	.post-item a:hover .post-read {
		color: var(--accent);
	}
	.all-posts-link {
		margin-top: 2.5rem;
	}
	.all-posts-link a {
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 2px;
		transition: color 0.15s ease;
	}
	.all-posts-link a:hover {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		.post-list {
			grid-template-columns: 1fr 1fr;
		}
		.post-item.featured {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 768px) {
		.hero-content {
			padding: 0 1.5em;
			bottom: 12%;
		}
		main {
			padding: 0 1.25em;
		}
		.post-list {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.post-item.featured {
			grid-column: 1;
		}
	}
</style>
