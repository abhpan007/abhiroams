---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero fade-in">
				<h1 class="tagline">I roam.<br />You should too.</h1>
				<p class="intro">
					Dispatches from wherever I end up — restaurants worth the detour, trails that surprise
					you, and places that make you want to stay longer.
				</p>
				<a href="/blog" class="cta">Read the blog &rarr;</a>
			</section>

			<section class="recent-posts">
				<h2 class="section-heading">Recent</h2>
				<ul class="post-list">
					{
						posts.map((post, index) => (
							<li class={index === 0 ? 'post-item featured fade-in' : 'post-item fade-in'}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage ? (
										<div class="post-image">
											<Image
												width={index === 0 ? 1100 : 600}
												height={index === 0 ? 520 : 400}
												src={post.data.heroImage}
												alt={post.data.title}
											/>
										</div>
									) : (
										<div class="post-image post-image-placeholder">
											<span>{post.data.title.charAt(0)}</span>
										</div>
									)}
									<div class="post-meta">
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="post-title">{post.data.title}</h3>
										{post.data.description && (
											<p class="post-description">{post.data.description}</p>
										)}
										<span class="post-read">Read &rarr;</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
				<div class="all-posts-link fade-in">
					<a href="/blog">All posts &rarr;</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.08 },
	);
	document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>

<style>
	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 2em;
	}

	/* Scroll animations */
	.fade-in {
		opacity: 0;
		transform: translateY(32px);
		transition: opacity 0.65s ease, transform 0.65s ease;
	}
	.fade-in.visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Hero */
	.hero {
		padding: 5em 0 4em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.tagline {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: rgb(var(--black));
		margin: 0 0 1rem 0;
	}
	.intro {
		font-size: 1.125rem;
		color: rgb(var(--gray));
		max-width: 520px;
		line-height: 1.7;
		margin: 0 0 2rem 0;
	}
	.cta {
		display: inline-block;
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 2px;
		transition: color 0.15s ease;
	}
	.cta:hover {
		color: var(--accent);
	}

	/* Recent posts */
	.recent-posts {
		padding: 3.5em 0 4em;
	}
	.section-heading {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin: 0 0 2rem 0;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2rem;
	}
	.post-item.featured {
		grid-column: 1 / -1;
	}
	.post-item a {
		display: block;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.post-item a:hover .post-title {
		color: var(--accent);
	}
	.post-image {
		margin-bottom: 1rem;
		overflow: hidden;
		border-radius: 6px;
		background: rgb(var(--gray-light));
	}
	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 6px;
		transition: transform 0.5s ease;
	}
	.post-item a:hover .post-image img {
		transform: scale(1.04);
	}
	.post-item.featured .post-image {
		aspect-ratio: 16 / 7;
	}
	.post-item:not(.featured) .post-image {
		aspect-ratio: 3 / 2;
	}
	.post-image-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.post-image-placeholder span {
		font-size: 4rem;
		font-weight: 700;
		color: rgb(var(--gray));
		opacity: 0.25;
	}
	.post-date {
		margin: 0 0 0.375rem 0;
		font-size: 0.8rem;
		color: rgb(var(--gray));
		letter-spacing: 0.04em;
	}
	.post-title {
		margin: 0 0 0.5rem 0;
		font-size: 1.2rem;
		line-height: 1.25;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}
	.post-item.featured .post-title {
		font-size: 1.75rem;
	}
	.post-description {
		margin: 0 0 0.75em;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		line-height: 1.5;
	}
	.post-read {
		font-size: 0.85rem;
		font-weight: 600;
		color: rgb(var(--black));
		border-bottom: 2px solid var(--accent);
		padding-bottom: 1px;
		transition: color 0.15s ease;
	}
	.post-item a:hover .post-read {
		color: var(--accent);
	}

	.all-posts-link {
		margin-top: 2.5rem;
	}
	.all-posts-link a {
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 2px;
		transition: color 0.15s ease;
	}
	.all-posts-link a:hover {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		.post-list {
			grid-template-columns: 1fr 1fr;
		}
		.post-item.featured {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 600px) {
		main {
			padding: 0 1em;
		}
		.hero {
			padding: 3em 0 2.5em;
		}
		.post-list {
			grid-template-columns: 1fr;
		}
		.post-item.featured {
			grid-column: 1;
		}
	}
</style>
